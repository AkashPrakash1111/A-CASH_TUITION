# Copy to backend/.env for local use, or set these in your host's dashboard.
JWT_SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=you@example.com                        # creates the first admin on an empty database
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin
ANTHROPIC_API_KEY=                                 # optional, for AI Studio
AI_MODEL=claude-sonnet-5
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # free Neon Postgres; leave empty locally to use SQLite
# DATA_DIR=/data                                   # only if you keep SQLite + uploads on a persistent disk
# CORS_ORIGINS=https://your-site.example           # only if the site is hosted separately from the API
